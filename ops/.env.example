MYSQL_ROOT_PASSWORD=toolmysql
MYSQL_DATABASE=tool_share

REDIS_PASSWORD=toolredis

# RabbitMQ 为预留组件，当前业务未接入
RABBITMQ_DEFAULT_USER=toolrabbitmq
RABBITMQ_DEFAULT_PASS=toolrabbitmq

MINIO_ROOT_USER=toolminio
MINIO_ROOT_PASSWORD=toolminio

QDRANT_API_KEY=toolqdrant

# 身份证 AES 密钥（16/24/32 字节），必填且无默认值；生成示例：openssl rand -hex 16
ID_CARD_AES_KEY=0123456789abcdef0123456789abcdef

# DeepSeek 对话模型（可选）。留空时 AI 问答与推荐自动降级，不影响其他功能
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 可选：覆盖应用连接地址（默认值与 docker-compose.yml 的端口映射一致）
# OLLAMA_BASE_URL=http://localhost:11934/v1
# QDRANT_HOST=localhost
# MINIO_ENDPOINT=http://localhost:9500
# MINIO_BUCKET=tool-share
