<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cdwater.toolshare.rental.mapper.RentalOrderMapper">

    <sql id="voSelect">
        SELECT
            ro.id,
            ro.order_no,
            ro.tool_id,
            t.tool_code,
            t.name        AS tool_name,
            ro.user_id,
            u.real_name   AS user_name,
            u.phone       AS user_phone,
            ro.pickup_name,
            ro.start_time,
            ro.end_time,
            ro.deposit_amount,
            ro.deposit_status,
            ro.status,
            ro.cancel_time,
            ro.return_time,
            ro.accept_result,
            ro.overdue_fee,
            ro.deposit_refund_amount,
            ro.create_time,
            ro.update_time
        FROM rental_order ro
        LEFT JOIN tool t ON t.id = ro.tool_id
        LEFT JOIN user u ON u.id = ro.user_id
    </sql>

    <sql id="voWhere">
        <where>
            <if test="q.userName != null and q.userName != ''">
                AND u.real_name LIKE CONCAT('%', #{q.userName}, '%')
            </if>
            <if test="q.toolCode != null and q.toolCode != ''">
                AND t.tool_code LIKE CONCAT('%', #{q.toolCode}, '%')
            </if>
            <if test="q.acceptResult != null">
                AND ro.accept_result = #{q.acceptResult}
            </if>
            <if test="q.overdue != null and q.overdue">
                AND ro.status = 3
                AND ro.end_time &lt; NOW()
            </if>
            <if test="userId != null">
                AND ro.user_id = #{userId}
            </if>
        </where>
    </sql>

    <select id="selectVoPage" resultType="com.cdwater.toolshare.rental.vo.RentalOrderVO">
        <include refid="voSelect"/>
        <include refid="voWhere"/>
        ORDER BY ro.create_time DESC, ro.id DESC
    </select>

    <select id="selectVoList" resultType="com.cdwater.toolshare.rental.vo.RentalOrderVO">
        <include refid="voSelect"/>
        <include refid="voWhere"/>
        ORDER BY ro.create_time DESC, ro.id DESC
    </select>

    <select id="selectVoById" resultType="com.cdwater.toolshare.rental.vo.RentalOrderVO">
        <include refid="voSelect"/>
        WHERE ro.id = #{id}
    </select>

</mapper>
